---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPostsByLocale } from "@/utils/getPostsByLocale";
import { SITE } from "@/config";
import { t } from "@/i18n";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getPostsByLocale(await getCollection("blog"), "zh-TW");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<Layout title={`${t("zh-TW", "tags")}: ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`${t("zh-TW", "tags")}:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={t("zh-TW", "tagDescription", { tag: tagName })}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
