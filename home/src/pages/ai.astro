---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import AIUsageDashboard from "../components/ai/AIUsageDashboard.astro";
import { SITE } from "../config";
import { getLocaleFromPath, t } from "@/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
---

<Layout title={`${t(locale, "ai")} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="ai" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{t(locale, "ai")}</h1>
      <p class="mb-6 text-gray-600 dark:text-gray-400">
        {t(locale, "aiDescription")}
      </p>

      <AIUsageDashboard />
    </section>
  </main>
  <Footer />
</Layout>
